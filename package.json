{
  "name": "zeus-time",
  "version": "0.3.1",
  "description": "Deterministic, cryptographically verifiable time hashing for Node, browser, and Expo/React Native.",
  "license": "Apache-2.0",
  "author": "TIMESync38",
  "repository": {
    "type": "git",
